rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserOfficeId() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.officeId
        : '';
    }

    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /offices/{officeId} {
      // Any authenticated user can create an office (during onboarding)
      allow create: if isAuthenticated();
      // Users can only read/update/delete their own office
      allow read, update, delete: if isAuthenticated() && getUserOfficeId() == officeId;
    }

    match /publicForms/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /leads/{leadId} {
      allow create: if (isAuthenticated() && getUserOfficeId() == request.resource.data.officeId) || (
        request.resource.data.createdVia == 'public_form' &&
        request.resource.data.officeId is string && request.resource.data.officeId != '' &&
        request.resource.data.publicFormSlug is string && request.resource.data.publicFormSlug != '' &&
        request.resource.data.consentLgpd == true &&
        request.resource.data.status == 'Novo contato' &&
        request.resource.data.priority == 'Média' &&
        request.resource.data.name is string && request.resource.data.name != '' &&
        request.resource.data.phone is string && request.resource.data.phone != '' &&
        request.resource.data.summary is string && request.resource.data.summary != '' &&
        !('cpf' in request.resource.data) &&
        !('rg' in request.resource.data) &&
        !('numeroProcesso' in request.resource.data) &&
        !('documentos' in request.resource.data) &&
        !('files' in request.resource.data) &&
        !('attachments' in request.resource.data)
      );
      allow read, update, delete: if isAuthenticated() && getUserOfficeId() == resource.data.officeId;
    }

    match /leadEvents/{eventId} {
      allow create: if (isAuthenticated() && getUserOfficeId() == request.resource.data.officeId) || request.resource.data.createdBy == 'public_form';
      allow read, update, delete: if isAuthenticated() && getUserOfficeId() == resource.data.officeId;
    }

    match /tasks/{taskId} {
      allow create: if isAuthenticated() && getUserOfficeId() == request.resource.data.officeId;
      allow read, update, delete: if isAuthenticated() && getUserOfficeId() == resource.data.officeId;
    }
  }
}
